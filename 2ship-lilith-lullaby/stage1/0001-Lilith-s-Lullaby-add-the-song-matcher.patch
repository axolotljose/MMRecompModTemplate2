Date: Thu, 1 Oct 2026 11:38:08 +0000
Subject: [PATCH 1/3] Lilith's Lullaby: add the song matcher

Adds a small, game-independent matcher that recognises the melody
C-Up, C-Left, C-Right, C-Left, C-Up, C-Left, C-Down from the ocarina staff
(position, last button, vanilla song state) sampled once per frame.

It keeps a rolling history of the last 7 notes and discards it when the
staff position skips ahead (a note went by unseen), when the ocarina is
reopened (position 0), when the game recognises one of its own songs, or
when an invalid button is reported.

The melody does not collide with any of the 24 vanilla song patterns in
gOcarinaSongButtons, in either direction.

Nothing uses the header yet.
---
 .../Songs/LilithsLullabyTracker.h             | 101 ++++++++++++++++++
 1 file changed, 101 insertions(+)
 create mode 100644 mm/2s2h/Enhancements/Songs/LilithsLullabyTracker.h

diff --git a/mm/2s2h/Enhancements/Songs/LilithsLullabyTracker.h b/mm/2s2h/Enhancements/Songs/LilithsLullabyTracker.h
new file mode 100644
index 0000000..be192ea
--- /dev/null
+++ b/mm/2s2h/Enhancements/Songs/LilithsLullabyTracker.h
@@ -0,0 +1,101 @@
+#ifndef LILITHS_LULLABY_TRACKER_H
+#define LILITHS_LULLABY_TRACKER_H
+
+#include <cstddef>
+#include <cstdint>
+
+/**
+ * Recognises Lilith's Lullaby from the notes the player plays on the ocarina.
+ *
+ * This header depends on nothing from the game so that the matcher can be unit tested on the host. The game side
+ * (LilithsLullaby.cpp) feeds it the playing ocarina staff once per frame.
+ *
+ * Buttons use the game's OcarinaButtonIndex values, LilithsLullaby.cpp asserts at compile time that they match.
+ */
+namespace LilithsLullaby {
+
+static constexpr uint8_t NOTE_A = 0;
+static constexpr uint8_t NOTE_C_DOWN = 1;
+static constexpr uint8_t NOTE_C_RIGHT = 2;
+static constexpr uint8_t NOTE_C_LEFT = 3;
+static constexpr uint8_t NOTE_C_UP = 4;
+
+// C-Up, C-Left, C-Right, C-Left, C-Up, C-Left, C-Down
+static constexpr size_t MELODY_LENGTH = 7;
+static constexpr uint8_t MELODY[MELODY_LENGTH] = {
+    NOTE_C_UP, NOTE_C_LEFT, NOTE_C_RIGHT, NOTE_C_LEFT, NOTE_C_UP, NOTE_C_LEFT, NOTE_C_DOWN,
+};
+
+class Tracker {
+  public:
+    void Reset() {
+        count = 0;
+        lastPos = 0;
+    }
+
+    /**
+     * Feeds one sample of the playing staff. Returns true when the last MELODY_LENGTH notes are the melody.
+     *
+     * @param pos          notes played in the current 8 note window (wraps 8 -> 1), 0 right after the ocarina opens
+     * @param button       the last button played
+     * @param vanillaState 0xFE while the game has not recognised one of its own songs, lower when it has
+     */
+    bool Feed(uint8_t pos, uint8_t button, uint8_t vanillaState) {
+        if (vanillaState < 0xFE) {
+            // The game recognised one of its own songs, never treat that as ours.
+            Reset();
+            return false;
+        }
+        if (pos == 0) {
+            Reset();
+            return false;
+        }
+        if (pos == lastPos) {
+            // Same note as the previous sample, nothing new was played.
+            return false;
+        }
+        if (lastPos != 0 && pos != static_cast<uint8_t>((lastPos % 8) + 1)) {
+            // Notes went by unseen, the history can no longer be trusted.
+            count = 0;
+        }
+        lastPos = pos;
+        if (button > NOTE_C_UP) {
+            count = 0;
+            return false;
+        }
+        Push(button);
+        return Matches();
+    }
+
+  private:
+    void Push(uint8_t button) {
+        if (count < MELODY_LENGTH) {
+            history[count++] = button;
+            return;
+        }
+        for (size_t i = 0; i + 1 < MELODY_LENGTH; i++) {
+            history[i] = history[i + 1];
+        }
+        history[MELODY_LENGTH - 1] = button;
+    }
+
+    bool Matches() const {
+        if (count < MELODY_LENGTH) {
+            return false;
+        }
+        for (size_t i = 0; i < MELODY_LENGTH; i++) {
+            if (history[i] != MELODY[i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    uint8_t history[MELODY_LENGTH] = {};
+    size_t count = 0;
+    uint8_t lastPos = 0;
+};
+
+} // namespace LilithsLullaby
+
+#endif // LILITHS_LULLABY_TRACKER_H
